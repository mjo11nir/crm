# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# >= 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-0000000000
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:8080
PUBLIC_BOOKING_BASE_URL=http://localhost:3001
# off | on — the DB-backed notification worker (sandbox adapter; no real messages are sent)
NOTIFICATIONS_WORKER=on

# booking-web
API_INTERNAL_URL=http://localhost:3000/api/v1

# Not yet integrated (see docs/known-limitations.md) — placeholders only:
# FCM_SERVICE_ACCOUNT_JSON=
# SMTP_URL=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_CLOUD_API_TOKEN=
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
# APP_STORE_SHARED_SECRET=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
